+def _skill(conn: sqlite3.Connection, body: dict) -> tuple[float, str | None]:
+    """What his role, and what has been said about him, say he knows about fighting: a factor and the package's word."""
+    cfg = data(conn).get("fighting") or {}
+    r = conn.execute("SELECT COALESCE(subtype,''), COALESCE(notes,'') FROM actors WHERE id=?", (body["id"],)).fetchone()
+    said = [i["text"] for i in json.loads(body["rec"]["stated_json"] or "{}").get("items") or []]
+    hits = _lexicon(". ".join([r[0], r[1], *said]).lower(), cfg.get("skills") or [], cfg.get("negations") or [])
+    if not hits:
+        return 1.0, None
+    best = max(hits, key=lambda h: float(h["factor"]))
+    return float(best["factor"]), str(best["word"])
+
+
+def _ability(conn: sqlite3.Connection, body: dict) -> float:
+    """What somebody brings to a fight with the hands: the body, the skill, and the fights already behind them."""
+    fought = conn.execute("""SELECT COUNT(*) FROM harm_incidents
+                             WHERE json_extract(metadata_json,'$.offender_actor_id')=? AND intent_class='hostile' """,
+                          (body["id"],)).fetchone()[0]
+    seasoned = 1.0 + float((data(conn).get("fighting") or {}).get("per_log_fight", 0.0)) * math.log1p(fought)
+    return body["force"] * _skill(conn, body)[0] * seasoned
+
