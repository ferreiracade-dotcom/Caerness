# Installed as /etc/caerness/caerness.env by install.sh (only if absent; never overwritten).
# Mode 640, owner root:caerness. Never commit the real file.
# Generate the hash with:
#   sudo -u caerness /opt/caerness/.venv/bin/python -m connector.set_passphrase
CAERNESS_PUBLIC_URL=https://YOUR-NAME.duckdns.org
CAERNESS_AUTH_DB=/var/lib/caerness/auth.db
CAERNESS_PASSPHRASE_HASH=CHANGE_ME
CAERNESS_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
CAERNESS_CAMPAIGN=main
CAERNESS_MAX_ADVANCE_DAYS=30
CAERNESS_BACKUP_DIR=/var/lib/caerness/backups
