[Unit]
Description=Caerness campaign snapshot (SQLite backup API) and rotation

[Service]
Type=oneshot
User=caerness
Group=caerness
WorkingDirectory=/opt/caerness
EnvironmentFile=/etc/caerness/caerness.env
Environment=CAERNESS_CAMPAIGN_DIR=/var/lib/caerness/campaigns
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/caerness/.venv/bin/python -m connector.backup --all --label daily
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/caerness
ProtectHome=yes
PrivateTmp=yes
